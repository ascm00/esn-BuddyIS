				"view": {
					"sql": "\n\tSELECT\n\t\tgen_random_uuid() AS id,\n\t\tac.id as application_cz_id,\n\t\tCASE \n\t\t\tWHEN hba.number >= ac.how_many_buddies THEN 'paired'\n\t\t\tELSE 'toBePaired'\n\t\tEND AS status\n\tFROM\n\t\tapplication_cz AS ac\n\tJOIN\n\t\thow_many_buddies_assigned AS hba ON hba.application_cz_id = ac.id\n"
				}
			}
